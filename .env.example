# Copy to .env (never commit .env). Everything here is optional until you go live.

# TypeSafe AI's Jev — second opinion on entries (advisory by default)
JEV_API_KEY=

# Phone notifications via the free ntfy app: subscribe to this topic in the app.
# Use a long random name; anyone who guesses it can read your desk's messages.
NTFY_TOPIC=

# If you expose the dashboard beyond your own machine, protect the kill switches.
DASHBOARD_TOKEN=

# ---- live trading only (python -m desk live) ----
# Hyperliquid: use an API wallet (Settings → API) — not your main wallet's key.
HL_WALLET_ADDRESS=
HL_PRIVATE_KEY=
# Other ccxt venues (binanceusdm, bybit, okx, krakenfutures):
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSWORD=
# Live trading refuses to start unless this is set to exactly:
# DESK_LIVE_CONFIRM=I understand this trades real money and can lose all of it
DESK_LIVE_CONFIRM=
